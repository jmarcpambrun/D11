    "K" => ["Khaki"],
    "L" => ["Lavender", "Lemon", "Lilac", "Lime"],
    "M" => ["Magenta", "Maroon", "Mauve", "Mint", "Mustard"],
    "N" => ["Navy"],
    "O" => ["Ochre", "Olive", "Orange", "Orchid"],
    "P" => [
      "Peach",
      "Pear",
      "Periwinkle",
      "Pink",
      "Plum",
      "Prussian Blue",
      "Purple",
    ],
    "R" => ["Red", "Rose", "Ruby", "Russet"],
    "S" => ["Saffron", "Salmon", "Sapphire", "Scarlet", "Silver"],
    "T" => ["Teal", "Turquoise"],
    "U" => ["Ultramarine"],
    "V" => ["Vermilion", "Violet"],
