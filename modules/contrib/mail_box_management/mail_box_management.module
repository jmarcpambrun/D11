  $first_letter = strtoupper(substr($string, 0, 1));
  $picked_color = $colors[$first_letter];
  return array_rand($colors);
}

/**
 * Implements hook_mail() for sending HTML emails with attachments.
 */
function mail_box_management_mail($key, &$message, $params): void {
  if ($key == 'mail_box_management_key') {
    $message['from'] = \Drupal::config('system.site')->get('mail');
    $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed';
    $message['body'][] = $params['message'];
    $message['subject'] = $params['subject'];
    if (!empty($params['attachments'])) {
      foreach ($params['attachments'] as $attachment) {
        if (!empty($attachment)) {
          $file = File::load($attachment);
          if ($file instanceof File) {
            $message['params']['attachments'][] = [
              'filepath' => $file->getFileUri(),
              'filename' => $file->getFilename(),
              'filemime' => $file->getMimeType(),
            ];
          }
        }
      }
    }
  }
}

/**
 * Implements hook_cache_flush().
 */
function mail_box_management_cache_flush(): void {
  $config_helper = mail_box_management_service('mail_box_management.config');
  $cache_settings = $config_helper->get('cache_mail_clear')?->get('cache_mail_clear');
  if ($cache_settings) {
    mail_box_management_service('mail_box_management.local.storage')
      ->clearLocalStorage();
  }
}

/**
 * Implements hook_cron().
 */
function mail_box_management_cron(): void {
  $config_helper = mail_box_management_service('mail_box_management.config');
  $cache_settings = $config_helper->get('cache_mail_cron')?->get('cache_mail_cron');
  if ($cache_settings) {
    $local_storage = mail_box_management_service('mail_box_management.local.storage');
    // Load all mail here into cache.
    $imap_servers = $config_helper->get('mail_box_management.settings')?->get('imap_servers') ?? [];
    foreach ($imap_servers as $server) {
      $imap_class = new ImapConnection($server);
      $mail_box = new MailBoxStorage($imap_class);
      $mailboxes = $mail_box->getMailboxes();
      if ($mailboxes) {
        foreach ($mailboxes as $name => $mailbox) {
          $mail = new EmailContentManager($imap_class);
          $mail->worker($mailbox, $server['owner_id']);
          $mails = $mail->getAllEmailMsgno($mailbox);
          if ($mails) {
            foreach ($mails as $msgno) {
              $mail_found = $mail->getByLoaderCall($mailbox, $msgno, $server['owner_id']);
              $content = mail_box_management_service('mail_box_management.theme')
                ->getThemeTemplateContent('mail-box-management-content-view',
                  ['emails' => $mail_found]);
              $local_storage->templateContentSaver("$mailbox._.$msgno._.{$server['owner_id']}", $content);
            }
          }
        }

      }
    }
  }
}
