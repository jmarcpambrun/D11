/**
 * Implements hook_page_attachments().
 */

/**
 * Implements hook_theme().
 */
function mail_box_management_page_attachments(array &$attachments): void {

  if (mail_box_management_is_mailbox_route()) {
    $attachments['#attached']['library'][] = 'mail_box_management/assets_management';
  }
}

/**
 * Check if we are not mailbox route.
 *
 * @return bool
 *   True if current page is mailbox.
 */
function mail_box_management_is_mailbox_route(): bool {
  // Get the current route name.
  $route_name = \Drupal::routeMatch()->getRouteName();
  $mail_box_routes = [
    'mail_box_management.configuration',
    'mail_box_management.mailbox_panel',
  ];
  return in_array($route_name, $mail_box_routes);
}

/**
 * Get services drupal offers.
 *
 * @param string $service_name
 *   Service name or key.
 *
 * @return mixed
 *   Service instance.
 */
function mail_box_management_service(string $service_name): mixed {
  return \Drupal::service($service_name);
}

/**
 * Implements hook_theme().
 */
function mail_box_management_color(string $string): array|int|string {
  $colors = [
