<div class="maestro-timeline-wrapper">
  {% for i in range(1,stage_count) %}
    {% set msg = stage_messages[i].message %}
    {# The status machine name set by the task that reached this stage, if any. #}
    {% set status = stage_messages[i].status|default('') %}
    {% if i == current_stage %}
      {% set class = 'maestro-status-circle-current' %}
      {% set msg = current_stage_message %}
    {% elseif i < current_stage %}
      {% set class = 'maestro-status-circle-complete' %}
    {% else %}
      {% set class = 'maestro-status-circle-incomplete' %}
    {% endif %}
    
    <div class="{{ class }}{% if status %} maestro-stage-status--{{ status|clean_class }}{% endif %}" title="{{ msg }}"{% if status %} data-stage-status="{{ status }}"{% endif %}>
      <span>{{ i }}</span>
    </div>
    <div class="stage-status-message{% if status %} maestro-stage-status--{{ status|clean_class }}{% endif %}">
      {{ msg }}
    </div>
    {% if i < stage_count %}
      <div class="{{ class }}-bar"> </div>
    {% endif %}
  {% endfor %}
</div>
