/**
 * Update 10007 - Create the Regeneration Count (regen_count) field on Queue
 */
function maestro_update_10007() {
  $message = '';
  if (!\Drupal::entityDefinitionUpdateManager()->getFieldStorageDefinition('regen_count', 'maestro_queue')) {
    $storage_definition = BaseFieldDefinition::create('integer')
      ->setLabel(t('Regeneration Count'))
      ->setDescription(t('The regeneration count.'))
      ->setSettings([
        'default_value' => '0',
        ])
      ->setReadOnly(FALSE);

    \Drupal::entityDefinitionUpdateManager()
      ->installFieldStorageDefinition('regen_count', 'maestro_queue', 'maestro_queue', $storage_definition);
    
    // Clear cache to ensure entity updates are recognized.
    drupal_flush_all_caches();
  }
  else {
    $message = t('Reneration Count field already exists in maestro_queue.');
  }

  try {
    $indexsql = "CREATE INDEX imaestro_queue_regen_count ON {maestro_queue} (regen_count) COMMENT '' ALGORITHM DEFAULT LOCK DEFAULT";
    $database = \Drupal::database();
    $database->query($indexsql);
    $message .= t('Added an index to the new regen_count column.');
  }
  catch(\Exception $e) {
    //Ignore the error as the index already exists
  }

  try {
    $database = \Drupal::database();
    $database->query("UPDATE {maestro_queue} SET regen_count = 0");
    $message .= t('Set regen count column to 0 for all rows.');
   }
  catch(\Exception $e) {
    $message .= t('Error setting regen_count column values to 0.');
  }
  return $message;
}

