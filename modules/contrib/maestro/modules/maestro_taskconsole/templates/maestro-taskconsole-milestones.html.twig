{# Stage position conveys progress, not individual task completion. #}
<section class="maestro-milestones" aria-label="{{ 'Workflow Milestones'|t }}">
  <div class="maestro-section-heading">
    <h3>{{ 'Workflow Milestones'|t }}</h3>
    <span class="maestro-muted">{{ summary }}</span>
  </div>
  <ol class="maestro-milestones__list">
    {% for step in steps %}
      <li class="maestro-milestones__step maestro-milestones__step--{{ step.state }}{% if step.status %} maestro-stage-status--{{ step.status|clean_class }}{% endif %}"{% if step.status %} data-stage-status="{{ step.status }}"{% endif %}{% if step.current %} aria-current="step"{% endif %}>
        <span class="maestro-milestones__number" aria-hidden="true">{{ step.number }}</span>
        <div>
          <span class="maestro-milestones__label">{{ 'Stage @number'|t({'@number': step.number}) }}{% if step.label %}: {{ step.label }}{% endif %}</span>
          <span class="maestro-milestones__state">{{ step.state_label }}</span>
        </div>
      </li>
    {% endfor %}
  </ol>
</section>
