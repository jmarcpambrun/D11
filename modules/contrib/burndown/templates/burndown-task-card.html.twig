<div
  {{ attributes.addClass('burndown_task', 'list-group-item', 'row') }}
  data-ticket-id="{{ data.ticket_id }}">

  <div class="action_links">
    {% if user.hasPermission('send tasks to backlog') %}
      {% if not data.sprint %}
      <div class="action_link">
        <a href="{{ url('<front>') }}burndown/api/board/send_to_backlog/{{ data.ticket_id }}"
          title="Send task to backlog"
          class="send_to_backlog"
          data-ticket-id="{{ data.ticket_id }}">
          Send Task to Backlog
        </a>
      </div>
      {% endif %}
    {% endif %}

    {% if user.hasPermission('edit task entities') %}
    <div class="action_link">
      <a href="{{ url('<front>') }}burndown/task/{{ data.id }}/edit"
        title="Edit task"
        class="use-ajax task_id{% if data.is_completed %} completed{% endif %} edit_task"
        data-dialog-type="modal"
        data-dialog-options="{&quot;width&quot;:&quot;80%&quot;,&quot;height&quot;:&quot;80%&quot;}">
        Edit task
      </a>
    </div>
    {% endif %}

    {% if user.hasPermission('burndown close task') %}
    <div class="action_link">
      <a href="{{ url('<front>') }}burndown/close_task/{{ data.ticket_id }}/board"
        title="Close the task. This will open a modal form."
        class="use-ajax close_task"
        data-dialog-type="modal"
        data-dialog-options="{&quot;width&quot;:800,&quot;height&quot;:500}">
        Close Task
      </a>
    </div>
    {% endif %}

  </div>

  <div class="ticket_title row">
    {% if user.hasPermission('view published task entities') or user.hasPermission(data.project_id ~ ' view project') %}
    <a href="{{ url('<front>') }}burndown/task/{{ data.id }}"
      class="use-ajax task_id{% if data.is_completed %} completed{% endif %}"
      data-dialog-type="modal"
      data-dialog-options="{&quot;width&quot;:&quot;80%&quot;,&quot;height&quot;:&quot;80%&quot;}">
    {% endif %}
      {{ data.name }}
    {% if user.hasPermission('view published task entities') or user.hasPermission(data.project_id ~ ' view project') %}
    </a>
    {% endif %}
  </div>

  <div class="tags">
  {% if data.tags is not empty %}
    {% for tag in data.tags[0:2] %}
    <div class="tag letter-{{ tag.first_letter }}">
      {{ tag.name }}
    </div>
    {% endfor %}
  {% endif %}
  </div>

  <div class="card_footer">

      <div
        class="priority priority-{{ data.priority }}"
        title="priority: {{ data.priority }}"
        aria-label="priority: {{ data.priority }}"></div>

      {% if estimate is not empty %}
        <div class="estimate estimate-type-{{ data.estimate_type }} estimate-{{ data.estimate }} circle">{{ data.estimate }}</div>
      {% endif %}

      <div class="ticket_id">
        {% if user.hasPermission('view published task entities') or user.hasPermission(data.project_id ~ ' view project') %}
        <a href="{{ url('<front>') }}burndown/task/{{ data.id }}"
          class="use-ajax task_id{% if data.is_completed %} completed{% endif %}"
          data-dialog-type="modal"
          data-dialog-options="{&quot;width&quot;:&quot;80%&quot;,&quot;height&quot;:&quot;80%&quot;}">
        {% endif %}
          {{ data.ticket_id }}
        {% if user.hasPermission('view published task entities') or user.hasPermission(data.project_id ~ ' view project') %}
        </a>
        {% endif %}
      </div>

      {% if user.hasPermission('burndown comment on task') %}
        {{ attach_library('burndown_time_tracker/task_timer') }}
        <button
          type="button"
          class="burndown-time-timer-toggle"
          data-task-ticket-id="{{ data.ticket_id }}"
          data-state="stopped"
          aria-label="start timer"
          title="start timer">
          <span class="visually-hidden burndown-time-timer-label">start timer</span>
          <svg class="burndown-time-hourglass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 2v6c0 2.59 1.67 4.78 4 5.6-2.33.82-4 3.01-4 5.6v2h12v-2c0-2.59-1.67-4.78-4-5.6 2.33-.82 4-3.01 4-5.6V2H6zm10 2v2H8V4h8zM8.9 19c.4-1.98 2.15-3.5 4.1-3.5s3.7 1.52 4.1 3.5H8.9z"/>
          </svg>
        </button>
      {% endif %}

      {% if data.assigned_to %}
        <div class="assigned_to user_circle circle" title="Assigned to {{ data.assigned_to }}" aria-label="Assigned to {{ data.assigned_to }}">
          {% if data.assigned_to_image %}
            <img src="{{ data.assigned_to_image }}" alt="Assigned to {{ data.assigned_to }}" title="Assigned to {{ data.assigned_to }}" class="circle" />
          {% else %}
            <span class="letter-{{ data.assigned_to_first_letter }} circle" title="Assigned to {{ data.assigned_to }}">{{ data.assigned_to_first_letter }}</span>
          {% endif %}
        </div>
      {% endif %}

  </div>

</div>
