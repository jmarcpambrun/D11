<div class="priority priority-{{ priority }}" title="priority: {{ priority }}" aria-label="priority: {{ priority }}"></div>

{# This should be wrapped in a permission checkbut there are several dynamic permissions that require the project id and that is not available. #}
<div class="task_link_group">
  <a href="{{ url('<front>') }}burndown/task/{{ id }}"
    class="use-ajax task_id{% if is_completed %} completed{% endif %} task_link_group_link"
    data-dialog-type="modal"
    data-dialog-options="{&quot;width&quot;:800,&quot;height&quot;:500}">
    <span class="ticket_id">{{ ticket_id }}</span>
    <span class="ticket_title">{{ name }}</span>
  </a>
</div>

{% if tags is not empty %}
  <div class="tags">
  {% for tag in tags[0:2] %}
  <div class="tag letter-{{ tag.first_letter }}">
    {{ tag.name }}
  </div>
  {% endfor %}
  </div>
{% endif %}

{% if assigned_to %}
  <div class="assigned_to user_circle circle" title="Assigned to {{ assigned_to }}" aria-label="Assigned to {{ assigned_to }}">
    {% if assigned_to_image %}
      <img src="{{ assigned_to_image }}" alt="Assigned to {{ assigned_to }}" title="Assigned to {{ assigned_to }}" class="circle" />
    {% else %}
      <span class="letter-{{ assigned_to_first_letter }} circle" title="Assigned to {{ assigned_to }}">{{ assigned_to_first_letter }}</span>
    {% endif %}
  </div>
{% endif %}

{% if estimate is not empty %}
  {% set estimate_units = estimate_type == 'tshirt' ? 'size' : 'points' %}
  <div class="estimate estimate-type-{{ estimate_type }} estimate-{{ estimate }} circle" title="Estimate: {{ estimate }} {{ estimate_units }}" aria-label="Estimate: {{ estimate }} {{ estimate_units }}">{{ estimate }}</div>
{% endif %}

{% if user.hasPermission('edit task entities') %}
<div class="action_link">
  <a href="{{ url('<front>') }}burndown/task/{{ id }}/edit?destination={{ url('<front>') }}burndown/{% if is_completed %}completed{% else %}backlog{% endif %}/{{ shortcode }}"
    title="Edit task"
    class="use-ajax task_id{% if is_completed %} completed{% endif %} edit_task"
    data-dialog-type="modal"
    data-dialog-options="{&quot;width&quot;:800,&quot;height&quot;:500}">
    Edit task
  </a>
</div>
{% endif %}

{% if backlog and not sprint %}
  {% if user.hasPermission('send tasks to board') %}
  <div class="action_link">
    <a href="{{ url('<front>') }}burndown/api/backlog/send_to_board/{{ ticket_id }}"
      title="Send task to the board"
      class="send_to_board"
      data-ticket-id="{{ ticket_id }}">
        Send to Board
    </a>
  </div>
  {% endif %}
{% endif %}

{% if not is_completed %}
  {% if user.hasPermission('burndown close task') %}
    {% if backlog or board %}
    <div class="action_link">
      <a href="{{ url('<front>') }}burndown/close_task/{{ ticket_id }}/backlog"
        title="Close the task (this will open a modal form)"
        class="use-ajax close_task"
        data-dialog-type="modal"
        data-dialog-options="{&quot;width&quot;:800,&quot;height&quot;:500}">
        Close Task
      </a>
    </div>
    {% endif %}
  {% endif %}
{% endif %}
