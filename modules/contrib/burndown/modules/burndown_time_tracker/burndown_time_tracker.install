<?php

/**
 * @file
 * Provides install and update hooks for the Burndown Time Tracker module.
 */

use Drupal\views\Entity\View;
use Symfony\Component\Yaml\Yaml;

/**
 * Implements hook_schema().
 */
function burndown_time_tracker_schema() {
  $schema['burndown_time_tracker_timer'] = [
    'description' => 'Tracks active per-user task timers.',
    'fields' => [
      'uid' => [
        'description' => 'User ID owning the active timer.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'task_id' => [
        'description' => 'Related Burndown task entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'started' => [
        'description' => 'Unix timestamp when the timer started.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['uid'],
    'indexes' => [
      'task_id' => ['task_id'],
      'started' => ['started'],
    ],
  ];

  return $schema;
}

/**
 * Install a Burndown View definition into active configuration.
 *
 * @param string $view_machine_name
 *   The machine name of the View to install.
 */
function burndown_time_tracker_install_view($view_machine_name): bool {
  $config_path = __DIR__ . '/config/install/views.view.' . $view_machine_name . '.yml';
  if (!file_exists($config_path)) {
    return FALSE;
  }

  $definition = Yaml::parseFile($config_path);
  if (!is_array($definition) || empty($definition['id'])) {
    return FALSE;
  }

  // Normalize the Date field to schema-valid keys for the Views date handler.
  if ($view_machine_name === 'burndown_hours' && isset($definition['display']['default']['display_options']['fields']['log_created'])) {
    $log_created = &$definition['display']['default']['display_options']['fields']['log_created'];
    $log_created['plugin_id'] = 'date';
    $stale_keys = [
      'click_sort_column',
      'group_column',
      'group_columns',
      'group_rows',
      'delta_limit',
      'delta_offset',
      'delta_reversed',
      'delta_first_last',
      'multi_type',
      'separator',
      'field_api_classes',
    ];
    foreach ($stale_keys as $key) {
      unset($log_created[$key]);
    }
    unset($log_created);
  }

  // Remove immutable export-only metadata keys if present.
  unset($definition['uuid']);
  unset($definition['_core']);

  $view = View::load($view_machine_name);
  if (!$view) {
    $view = View::create($definition);
    return (bool) $view->save();
  }

  $view->set('label', $definition['label'] ?? $view->label());
  $view->set('description', $definition['description'] ?? $view->get('description'));
  $view->set('base_table', $definition['base_table'] ?? $view->get('base_table'));
  $view->set('base_field', $definition['base_field'] ?? $view->get('base_field'));
  $view->set('display', $definition['display']);
  return (bool) $view->save();
}

/**
 * Update the Burndown hours view to use the page display.
 */
function burndown_time_tracker_update_9001() {
  $success = burndown_time_tracker_install_view('burndown_hours');
  if (!$success) {
    return t('Failed to update the Burndown hours View to match module configuration.');
  }
  return t("Updated the Burndown hours View to match module's config.");
}

/**
 * Ensure the timer table exists for active task timers.
 */
function burndown_time_tracker_update_9002() {
  $schema = burndown_time_tracker_schema();
  if (!\Drupal::database()->schema()->tableExists('burndown_time_tracker_timer')) {
    \Drupal::database()->schema()->createTable('burndown_time_tracker_timer', $schema['burndown_time_tracker_timer']);
    return t('Created the Burndown time tracker timer table.');
  }

  return t('No need to create the Burndown time tracker timer table, it exists.');
}

/**
 * Ensure the Burndown summary view exists and is current.
 */
function burndown_time_tracker_update_9003() {
  $success = burndown_time_tracker_install_view('burndown_hours_summary');
  if (!$success) {
    return t('Failed to install the Burndown hours summary View to match the module configuration.');
  }
  return t('Installed the Burndown hours summary View to match the module configuration. Be sure to assign the new perm "view work hours reports" to the appropriate roles to allow access to the summary report.');
}
