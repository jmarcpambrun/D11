<?php

/**
 * @file
 * Provides the main module file for the Burndown Time Tracker module.
 */

use Drupal\burndown_time_tracker\Hook\BurndownTimeTrackerHooks;
use Drupal\burndown_time_tracker\Hook\BurndownTimeTrackerViewsHooks;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function burndown_time_tracker_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(BurndownTimeTrackerHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_views_data_alter().
 */
#[LegacyHook]
function burndown_time_tracker_views_data_alter(array &$data) {
  \Drupal::service(BurndownTimeTrackerViewsHooks::class)->viewsDataAlter($data);
}

/**
 * Implements hook_page_attachments().
 */
#[LegacyHook]
function burndown_time_tracker_page_attachments(array &$attachments) {
  \Drupal::service(BurndownTimeTrackerViewsHooks::class)->pageAttachments($attachments);
}

/**
 * Implements hook_views_pre_view().
 */
#[LegacyHook]
function burndown_time_tracker_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  \Drupal::service(BurndownTimeTrackerViewsHooks::class)->viewsPreView($view, $display_id, $args);
}

/**
 * Implements hook_views_query_alter().
 */
#[LegacyHook]
function burndown_time_tracker_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  \Drupal::service(BurndownTimeTrackerViewsHooks::class)->viewsQueryAlter($view, $query);
}

/**
 * Implements hook_preprocess_burndown_task_card().
 */
#[LegacyHook]
function burndown_time_tracker_preprocess_burndown_task_card(array &$variables) {
  /** @var \Drupal\burndown_time_tracker\Hook\BurndownTimeTrackerHooks $hooks */
  $hooks = \Drupal::service(BurndownTimeTrackerHooks::class);
  $hooks->preprocessBurndownTaskCard($variables);
}
