<?php

/**
 * @file
 * Install, update, and uninstall functions for the Upgrade Status module.
 */
use Drupal\Component\Utility\DeprecationHelper;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\upgrade_status\ScanResultStorage;

/**
 * Implements hook_requirements().
 */
#[LegacyRequirementsHook]
function upgrade_status_requirements($phase) {
  if ($phase == 'install') {
    // Check if the Drupal Finder is available. This will attempt to autoload
    // the class, so we can bail out as soon as possible.
    if (!class_exists('DrupalFinder\DrupalFinderComposerRuntime')) {
      return [
        'upgrade_status' => [
          'description' => t('External dependencies for Upgrade Status are not available. Composer must be used to download the module with dependencies. See <a href="@url">the Upgrade Status project page</a> for instructions.', ['@url' => 'https://drupal.org/project/upgrade_status']),
          'severity' => DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.2.0', fn() => RequirementSeverity::Error, fn() => REQUIREMENT_ERROR),
        ],
      ];
    }
  }
  return [];
}

/**
 * Implements hook_uninstall().
 */
function upgrade_status_uninstall() {
  \Drupal::keyValue(ScanResultStorage::COLLECTION)->deleteAll();
  \Drupal::keyValue('upgrade_status_tool_updates')->deleteAll();
}

/**
 * Implements hook_update_last_removed().
 */
function upgrade_status_update_last_removed() {
  // Updates 8101, 8301 and 8302 removed data of the 8.x-1.x to 8.x-3.x
  // branches.
  return 8302;
}
