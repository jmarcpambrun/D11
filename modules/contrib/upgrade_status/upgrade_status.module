<?php

/**
 * @file
 * The base module for upgrade status.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\upgrade_status\Hook\UpgradeStatusHooks;
use Drupal\Core\Extension\Extension;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function upgrade_status_help($route_name, RouteMatchInterface $route_match) {

  return \Drupal::service(UpgradeStatusHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function upgrade_status_theme($existing, $type, $theme, $path) {
  return \Drupal::service(UpgradeStatusHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_system_info_alter().
 */
#[LegacyHook]
function upgrade_status_system_info_alter(array &$info, Extension $extension, $type) {
  \Drupal::service(UpgradeStatusHooks::class)->systemInfoAlter($info, $extension, $type);
}

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function upgrade_status_cron() {
  \Drupal::service(UpgradeStatusHooks::class)->cron();
}

/**
 * Implements hook_batch_alter().
 */
#[LegacyHook]
function upgrade_status_batch_alter(array &$batch) {
  \Drupal::service(UpgradeStatusHooks::class)->batchAlter($batch);
}
