# PHPStan configuration for Page Manager.
#
# This mirrors the default contrib configuration that the GitLab CI template
# supplies when a project ships no config of its own
# (gitlab_templates assets/phpstan.neon), plus the exclusions documented below.
# When a project provides this file the template uses it verbatim, so the
# baseline include from the default file is deliberately not carried over.
parameters:
    level: 0
    fileExtensions:
        - php
        - module
        - inc
        - install
        - theme
        - profile
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # new static() is a best practice in Drupal, so we cannot fix that.
        - "#^Unsafe usage of new static#"

        # The tests use PHPUnit attributes. Drupal 10 uses PHPUnit 9, which does
        # not have these attribute classes. PHP loads an attribute class only
        # when code reads the attribute. Thus, the tests run on Drupal 10.
        - "#^Attribute class PHPUnit\\\\Framework\\\\Attributes\\\\\\w+ does not exist\\.$#"

        # page_manager_update_8002() converts Panels layout ids and loads
        # panels.install to do it. Panels is not a dependency of Page Manager,
        # so it is absent from the analysed codebase, but the call is already
        # guarded at runtime by moduleExists('panels').
        -
            message: "#could not be loaded from Drupal\\\\Core\\\\Extension\\\\ModuleHandlerInterface::loadInclude because panels module is not found#"
            path: page_manager.install

        # Storing an entity storage handler in a property is discouraged, but
        # these are long-standing protected properties that subclasses in other
        # projects may read. Removing them would be an API break, so they are
        # left in place. New code should call getStorage() at the call site.
        -
            message: "#^Storing entity storage as a class property is not recommended#"
            paths:
                - page_manager_ui/src/Form/PageGeneralForm.php
                - src/Routing/PageManagerRoutes.php
                - src/Routing/VariantRouteFilter.php

        # The hook classes use the #[Hook] and #[LegacyHook] attributes.
        # Drupal 10 does not have these attribute classes. On Drupal 10, the
        # procedural hook functions run.
        - "#^Attribute class Drupal\\\\Core\\\\Hook\\\\Attribute\\\\\\w+ does not exist\\.$#"

        # The Page and PageVariant entity types use the #[ConfigEntityType]
        # attribute. Drupal 10 does not have this attribute class. On Drupal 10,
        # core reads the @ConfigEntityType annotation.
        -
            message: "#^Attribute class Drupal\\\\Core\\\\Entity\\\\Attribute\\\\ConfigEntityType does not exist\\.$#"
            paths:
                - src/Entity/Page.php
                - src/Entity/PageVariant.php
