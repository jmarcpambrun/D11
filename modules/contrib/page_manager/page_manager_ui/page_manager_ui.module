<?php

/**
 * @file
 * Provides a UI for Page Manager.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\page_manager_ui\Hook\PageManagerUiHooks;

/**
 * Implements hook_entity_type_build().
 */
#[LegacyHook]
function page_manager_ui_entity_type_build(array &$entity_types) {
  \Drupal::service(PageManagerUiHooks::class)->entityTypeBuild($entity_types);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function page_manager_ui_entity_type_alter(array &$entity_types) {
  \Drupal::service(PageManagerUiHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function page_manager_ui_theme() {
  return \Drupal::service(PageManagerUiHooks::class)->theme();
}

/**
 * Preprocess function for page-manager-wizard-tree.html.twig.
 */
function template_preprocess_page_manager_wizard_tree(&$variables) {
  \Drupal::service(PageManagerUiHooks::class)->preprocessPageManagerWizardTree($variables);
}

/**
 * Implements hook_config_translation_info_alter().
 */
#[LegacyHook]
function page_manager_ui_config_translation_info_alter(&$info) {
  \Drupal::service(PageManagerUiHooks::class)->configTranslationInfoAlter($info);
}

/**
 * Implements hook_local_tasks_alter().
 */
#[LegacyHook]
function page_manager_ui_local_tasks_alter(&$local_tasks) {
  \Drupal::service(PageManagerUiHooks::class)->localTasksAlter($local_tasks);
}
