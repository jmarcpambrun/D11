<div class="counter" id="counter">
    <div class="counter__items">
        {% set counters = {
            'site_counter': 'Site Counter:',
            'unique_visitor': 'Unique Visitor:',
            'registered_user': 'Registered Users:',
            'unregistered_user': 'Unregistered Users:',
            'blocked_user': 'Blocked Users:',
            'published_nodes': 'Published Nodes:',
            'unpublished_nodes': 'Unpublished Nodes:',
            'server_ip': 'Server IP Address:',
            'ip': 'IP Address:',
            'counter_since': 'Counter Since:'
        } %}
        {% for key, label in counters %}
            {% if (_context[key]) is not null %}
                <div class="counter__item {{ key }}">
                    <div class="counter__item-label">{{ label|t }}</div>
                    <div class="counter__item-value">{{ _context[key] }}</div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    {% if statistic_today or statistic_week or statistic_month or statistic_year %}
        <div class="statistic">
            <h3 class="statistic__title">{{ 'Visitors'|t }}</h3>
            <div class="statistic__items">
                {% set statistics = {
                    'statistic_today': 'Today:',
                    'statistic_week': 'This week:',
                    'statistic_month': 'This month:',
                    'statistic_year': 'This year:'
                } %}
                {% for key, label in statistics %}
                    {% if (_context[key]) is not null %}
                        <div class="statistic__item {{ key }}">
                            <div class="statistic__item-label">{{ label|t }}</div>
                            <div class="statistic__item-value">{{ _context[key] }}</div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    {% endif %}
</div>
