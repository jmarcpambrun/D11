<div class="counter-wrapper">
    <div class="counter-page">
        <div class="counter-filters">
            <label for="counter-range-select">{{ 'Period'|t({}, {'context': 'counter'}) }}</label>
            <select id="counter-range-select" name="range">
                <option value="today">{{ 'Today'|t({}, {'context': 'counter'}) }}</option>
                <option value="yesterday">{{ 'Yesterday'|t({}, {'context': 'counter'}) }}</option>
                <option value="7days"
                        selected>{{ 'Last 7 days'|t({}, {'context': 'counter'}) }}</option>
                <option value="30days">{{ 'Last 30 days'|t({}, {'context': 'counter'}) }}</option>
                <option value="month">{{ 'This month'|t({}, {'context': 'counter'}) }}</option>
                <option value="year">{{ 'This year'|t({}, {'context': 'counter'}) }}</option>
                <option value="all">{{ 'All the time'|t({}, {'context': 'counter'}) }}</option>
                <option value="custom">{{ 'Custom'|t({}, {'context': 'counter'}) }}</option>
            </select>

            <div id="counter-custom-dates"
                 style="display:none; margin-left:12px;">
                <label>{{ 'Start'|t({}, {'context': 'counter'}) }}</label>
                <input type="date" id="counter-custom-start"/>
                <label style="margin-left:8px;">{{ 'End'|t({}, {'context': 'counter'}) }}</label>
                <input type="date" id="counter-custom-end"/>
            </div>
        </div>

        <div class="counter-summary">
            <div id="metric-unique" class="metric metric--clickable is-active"
                 data-metric="unique" role="button" tabindex="0">
                <div class="metric-label">{{ 'Visitors'|t({}, {'context': 'counter'}) }}</div>
                <div id="counter-unique" class="metric-value">—</div>
            </div>
            <div id="metric-views" class="metric metric--clickable"
                 data-metric="views" role="button" tabindex="0">
                <div class="metric-label">{{ 'Views'|t({}, {'context': 'counter'}) }}</div>
                <div id="counter-views" class="metric-value">—</div>
            </div>
        </div>

        <div id="counter-notification" class="counter-notification"></div>

        <canvas id="counter-chart"></canvas>

        <div class="form-item">
            <label>
                <input type="checkbox"
                       id="counter-compare-checkbox"/> {{ 'Compare with the previous period'|t({}, {'context': 'counter'}) }}
            </label>
        </div>
    </div>
    <div class="counter-menu">
        <ul class="counter-menu-list">
            {% for item in counter_menu %}
                <li class="counter-menu-item {{ item.active ? 'is-active' : '' }}">
                    <a href="{{ item.url }}">{{ item.title }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>
