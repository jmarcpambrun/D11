<?php

/**
 * @file
 * Install, update and uninstall functions for the group module.
 */

/**
 * Implements hook_update_last_removed().
 */
function group_update_last_removed() {
  return 10305;
}

/**
 * Drop deprecated keys from config entities.
 */
function group_update_11400() {
  $config_factory = \Drupal::configFactory();

  // Drop creator_wizard key from group types.
  foreach ($config_factory->listAll('group.type.') as $config_name) {
    $group_type = $config_factory->getEditable($config_name);
    $group_type->clear('creator_wizard');
    $group_type->save(TRUE);
  }

  // Drop use_creation_wizard key from group relationship types.
  foreach ($config_factory->listAll('group.relationship_type.') as $config_name) {
    $relationship_type = $config_factory->getEditable($config_name);

    $plugin_config = $relationship_type->get('plugin_config');
    unset($plugin_config['use_creation_wizard']);
    $relationship_type->set('plugin_config', $plugin_config);

    $relationship_type->save(TRUE);
  }
}
