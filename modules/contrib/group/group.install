<?php

/**
 * @file
 * Install, update and uninstall functions for the group module.
 */

/**
 * Implements hook_update_last_removed().
 */
function group_update_last_removed() {
  return 10306;
}

/**
 * Drop deprecated keys from config entities.
 */
function group_update_11400() {
  $config_factory = \Drupal::configFactory();

  // Drop creator_wizard key from group types.
  foreach ($config_factory->listAll('group.type.') as $config_name) {
    $group_type = $config_factory->getEditable($config_name);
    $group_type->clear('creator_wizard');
    $group_type->save();
  }

  // Drop use_creation_wizard key from group relationship types.
  foreach ($config_factory->listAll('group.relationship_type.') as $config_name) {
    $relationship_type = $config_factory->getEditable($config_name);

    $plugin_config = $relationship_type->get('plugin_config');
    unset($plugin_config['use_creation_wizard']);
    $relationship_type->set('plugin_config', $plugin_config);

    $relationship_type->save();
  }
}

/**
 * Rename "content_plugin" to "relation_type" on group relationship types.
 */
function group_update_11401() {
  $config_factory = \Drupal::configFactory();
  foreach ($config_factory->listAll('group.relationship_type.') as $config_name) {
    $relationship_type = $config_factory->getEditable($config_name);

    $plugin_id = $relationship_type->get('content_plugin');
    $relationship_type->clear('content_plugin');
    $relationship_type->set('relation_type', $plugin_id);

    $relationship_type->save();
  }
}

/**
 * Updates members view to use admin theme.
 */
function group_update_11402() {
  if (\Drupal::moduleHandler()->moduleExists('views')) {
    $view = \Drupal::configFactory()->getEditable('views.view.group_members');
    if (!$view->isNew() && is_null($view->get('display.page_1.display_options.use_admin_theme'))) {
      $view->set('display.page_1.display_options.use_admin_theme', TRUE);
      $view->save();
    }
  }
}

/**
 * Updates group_members view argument to use 'group_id' plugin.
 */
function group_update_11403() {
  if (\Drupal::moduleHandler()->moduleExists('views')) {
    $view = \Drupal::configFactory()->getEditable('views.view.group_members');
    if (!$view->isNew()) {
      // Only update if the view was still using the original plugin ID.
      $config_key = 'display.default.display_options.arguments.gid.plugin_id';
      if ($view->get($config_key) === 'numeric') {
        $view->set($config_key, 'group_id');
        $view->save();
      }
    }
  }
}
