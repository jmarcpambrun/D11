        "drupal/entity_browser": "2.15",
        "drupal/entity_print": "2.18",
        "drupal/entity_reference_revisions": "1.14",
        "drupal/entity_update": "3.0.1",
        "drupal/entity_usage": "2.0-beta28",
        "drupal/eu_cookie_compliance": "1.30-RC2",
