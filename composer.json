        "drupal/captcha": "2.0.10",
        "drupal/charts": "5.1.10",
        "drupal/clientside_validation": "4.1.2",
        "drupal/composer_deploy": "1.10",
        "drupal/computed_field": "4.0.0",
        "drupal/computed_field_ui": "4.0.0",
        "drupal/content_access": "2.1-rc2",
        "drupal/content_planner": "^1.1",
        "drupal/core-vendor-hardening": "^10.2",
        "drupal/csv_serialization": "4.0.1",
        "drupal/ctools": "4.1.0",
        "drupal/devel": "5.5.0",
        "drupal/devel_entity_updates": "5.0.0",
        "drupal/drd": "4.1.7",
        "drupal/drd_agent": "^4.1",
